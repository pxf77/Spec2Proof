{
  "name": "spec2proof",
  "version": "0.4.0",
  "private": true,
  "description": "PR acceptance execution agent built with Strands Agents and Amazon Bedrock AgentCore.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "test:e2e": "node --import tsx --test e2e/*.test.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "validate:deploy": "node scripts/validate-deployment.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:deploy",
    "check:e2e": "npm run typecheck:e2e && npm run test:e2e",
    "read:agentcore-runtime-arn": "node scripts/read-agentcore-runtime-arn.mjs",
    "dev:demo": "tsx src/apps/local-demo.ts",
    "dev:demo-shop": "node scripts/serve-demo-shop.mjs",
    "dev:webhook": "tsx watch src/apps/webhook.ts",
    "dev:runtime": "tsx watch src/apps/agent-runtime.ts",
    "start:webhook": "node dist/apps/webhook.js",
    "start:runtime": "node dist/apps/agent-runtime.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1112.0",
    "@aws-sdk/client-dynamodb": "^3.1112.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/client-secrets-manager": "^3.1112.0",
    "@aws-sdk/client-sqs": "^3.1112.0",
    "@aws-sdk/lib-dynamodb": "^3.1112.0",
    "@strands-agents/sdk": "^1.14.0",
    "bedrock-agentcore": "^0.4.3",
    "playwright": "^1.61.0",
    "yaml": "^2.8.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.22.5",
    "typescript": "^5.8.3"
  }
}
