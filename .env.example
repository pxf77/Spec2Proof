# Shared
NODE_ENV=development
AWS_REGION=us-west-2
SPEC2PROOF_MODEL_ID=global.anthropic.claude-sonnet-4-6
LOG_LEVEL=info

# Local GitHub App webhook entrypoint
WEBHOOK_PORT=3000
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-github-app-private-key\n-----END PRIVATE KEY-----"
GITHUB_API_URL=https://api.github.com
SPEC2PROOF_AGENT_RUNTIME_URL=http://127.0.0.1:8080/invocations
SPEC2PROOF_AGENT_RUNTIME_TIMEOUT_SECONDS=900
SPEC2PROOF_MAX_CHANGED_FILES=100
SPEC2PROOF_MAX_PATCH_CHARS_PER_FILE=4000

# AgentCore-compatible runtime
AGENT_RUNTIME_PORT=8080
SPEC2PROOF_ALLOWED_HOSTS=pxf77.github.io
SPEC2PROOF_ALLOW_HTTP=false
SPEC2PROOF_ALLOW_PRIVATE_HOSTS=false
SPEC2PROOF_BROWSER_HEADLESS=true
SPEC2PROOF_BROWSER_PROVIDER=agentcore
SPEC2PROOF_AGENTCORE_BROWSER_ID=aws.browser.v1
SPEC2PROOF_EVIDENCE_STORE=s3
SPEC2PROOF_EVIDENCE_BUCKET=replace-with-foundation-stack-output
SPEC2PROOF_EVIDENCE_PREFIX=spec2proof
SPEC2PROOF_ARTIFACTS_DIR=artifacts
SPEC2PROOF_MAX_AGENT_TURNS=40

# AgentCore bootstrap script
AWS_ACCOUNT_ID=123456789012
SPEC2PROOF_AGENTCORE_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/replace-me
