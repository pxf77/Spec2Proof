# Shared
NODE_ENV=development
AWS_REGION=us-west-2
SPEC2PROOF_MODEL_ID=global.anthropic.claude-sonnet-4-6
LOG_LEVEL=info

# GitHub webhook entrypoint
WEBHOOK_PORT=3000
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# AgentCore-compatible runtime entrypoint
AGENT_RUNTIME_PORT=8080
SPEC2PROOF_ALLOWED_HOSTS=staging.example.com,api-staging.example.com
SPEC2PROOF_ALLOW_HTTP=false
SPEC2PROOF_ALLOW_PRIVATE_HOSTS=false
SPEC2PROOF_BROWSER_HEADLESS=true
SPEC2PROOF_ARTIFACTS_DIR=artifacts
SPEC2PROOF_MAX_AGENT_TURNS=40
